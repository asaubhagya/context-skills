{
  "name": "context-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Source of truth for the skills served by the Context MCPs (iOS, Web, Blog) and the Skills hub at https://app.onecontext.me/skills.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check-skills": "tsx scripts/check-skills.ts && tsx scripts/check-mcp-catalogs.ts",
    "check-mcp-catalogs": "tsx scripts/check-mcp-catalogs.ts",
    "build-manifest": "tsx scripts/build-manifest.ts",
    "build-site": "tsx scripts/build-site.ts",
    "check-manifest": "tsx scripts/build-manifest.ts --check",
    "channels": "tsx scripts/channels.ts",
    "check-channels": "tsx scripts/channels.ts check",
    "check-catalogs-live": "tsx scripts/check-catalogs-live.ts",
    "register-catalog": "tsx scripts/register-catalog.ts",
    "check-site-links": "tsx scripts/check-site-links.ts",
    "check-tool-names": "tsx scripts/check-tool-names.ts",
    "check-site": "pnpm build-site && pnpm check-site-links",
    "check": "pnpm check-skills && pnpm check-manifest && pnpm check-tool-names && pnpm check-channels",
    "package-context-plugin": "python3 scripts/package-context-plugin.py",
    "test-plugin-package": "python3 scripts/package-context-plugin.test.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "marked": "^15.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.28.0"
}
